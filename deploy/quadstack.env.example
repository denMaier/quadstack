# ~/.config/quadstack/quadstack.env (chmod 600)

# Where Quadstack listens. Keep it on localhost or the LAN and put a reverse proxy with TLS in front.
QUADSTACK_LISTEN=0.0.0.0:8090
# The address people open; the OIDC redirect URI is <this>/auth/callback
QUADSTACK_PUBLIC_URL=https://quadstack.example.com

QUADSTACK_OIDC_ISSUER=https://id.example.com
QUADSTACK_OIDC_CLIENT_ID=
QUADSTACK_OIDC_CLIENT_SECRET=
# QUADSTACK_OIDC_SCOPES=openid profile email groups
# QUADSTACK_OIDC_GROUPS_CLAIM=groups

# Who may sign in (at least one is required): sub, email or preferred_username, and/or groups
QUADSTACK_ALLOWED_USERS=
QUADSTACK_ALLOWED_GROUPS=homelab_admins

# Defaults shown
# QUADSTACK_QUADLET_DIR=~/.config/containers/systemd
# QUADSTACK_STATE_DIR=~/.local/state/quadstack
# QUADSTACK_QUADLET_BIN=/usr/libexec/podman/quadlet
# QUADSTACK_PODLET_BIN=     (found on PATH when installed)
# QUADSTACK_TERMINAL=true   (shells into containers from the browser, and the MCP exec tool)
# QUADSTACK_MCP_MAX_HOURS=24 (longest an MCP grant may last; 0 turns MCP access off)
